<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Edit Observation"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <EditText
        android:id="@+id/etEditObservation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Observation"
        android:minLines="3"
        android:gravity="top"
        android:inputType="textMultiLine" />

    <EditText
        android:id="@+id/etEditObservationTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Time"
        android:focusable="false"
        android:clickable="true" />

    <EditText
        android:id="@+id/etEditObservationComments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Additional comments"
        android:minLines="3"
        android:gravity="top"
        android:inputType="textMultiLine" />

    <Button
        android:id="@+id/btnUpdateObservation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="UPDATE OBSERVATION"
        android:layout_marginTop="20dp" />

</LinearLayout>